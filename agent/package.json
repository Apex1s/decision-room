{
  "name": "decision-room-agent",
  "version": "0.2.0",
  "description": "Decision Room: a pricing war room for concentrated markets, served over the Agent Client Protocol and MCP",
  "type": "module",
  "private": true,
  "bin": {
    "decision-room": "src/main.ts"
  },
  "scripts": {
    "agent": "bun src/main.ts",
    "demo": "bun src/cli.ts --demo",
    "chat": "bun src/cli.ts",
    "web": "bun src/web.ts",
    "mcp": "bun src/mcp.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "site": "bun scripts/build-site.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.1.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.2.17",
    "typescript": "5.8.3"
  }
}
